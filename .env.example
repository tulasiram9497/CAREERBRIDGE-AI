# GEMINI_API_KEY: Required for Gemini AI API calls (Resume analysis, matching, messaging, chatbot).
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Host URL for this applet
APP_URL="http://localhost:3000"

# MongoDB Atlas Configuration
# Obtain from MongoDB Atlas cluster: mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/careerbridge"
MONGODB_DATABASE="careerbridge"

# Django / Backend Configuration
DJANGO_SECRET_KEY="django-insecure-careerbridge-secret-key-change-in-production"
DJANGO_DEBUG="True"
DJANGO_ALLOWED_HOSTS="localhost,127.0.0.1,0.0.0.0"
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:3000"

# Redis & Celery Configuration (Optional for distributed queue)
REDIS_URL="redis://localhost:6379/0"

# JWT Authentication Settings
JWT_SECRET="careerbridge-jwt-super-secret-key-2026"
JWT_ACCESS_TOKEN_LIFETIME="86400"
JWT_REFRESH_TOKEN_LIFETIME="604800"

# External Integrations (Optional)
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/v1/auth/google/callback"
